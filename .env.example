# Environment Variables Template
# Copy this file to .env (which is gitignored) and fill in your actual values

# Example API keys (never commit actual values)
# API_KEY=your_api_key_here
# SECRET_KEY=your_secret_key_here
# DATABASE_URL=your_database_url_here

# Hugo specific environment variables
# HUGO_ENVIRONMENT=production
# HUGO_CACHEDIR=/tmp/hugo_cache

# Social media tokens (if needed for integrations)
# TWITTER_API_KEY=your_twitter_api_key
# GITHUB_TOKEN=your_github_token

# Analytics and tracking (if added later)
# GOOGLE_ANALYTICS_ID=your_ga_id
# FIREBASE_API_KEY=your_firebase_key

# Note: Always use environment variables for sensitive data
# Never commit actual API keys, passwords, or secrets to version control